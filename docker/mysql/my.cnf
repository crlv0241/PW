# Custom MySQL 8 Configuration for POS & WMS
# Optimized for ACID transactions, UTF-8 mb4 encoding, and high-concurrency ledger operations

[mysqld]
# Default character set and collation
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Storage Engine & ACID settings
default-storage-engine = InnoDB
innodb_file_per_table = 1
innodb_buffer_pool_size = 512M
innodb_log_file_size = 128M
innodb_flush_log_at_trx_commit = 1
innodb_lock_wait_timeout = 50

# Concurrency & Connections
max_connections = 200
connect_timeout = 10
wait_timeout = 600
interactive_timeout = 600
max_allowed_packet = 64M

# SQL Mode (Strict mode for financial & ledger accuracy)
sql_mode = "STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION,ONLY_FULL_GROUP_BY,STRICT_ALL_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO"

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
